# deform by tension
#1 general
echo			both
units		    metal
dimension	    3
atom_style      atomic
newton 			on
neighbor     	2 bin
neigh_modify 	delay 0

#2 structure

boundary	    p p f
read_data	    trilayer_3type_3.501A.lmp

#3 variables

variable	    temperature equal 300.0
variable	    pressure equal 1.01325
variable        tstep equal 0.0005
variable	    strainmax equal 0.3
variable	    srate equal 1.e8/1.e12
variable        tmp equal bound(all,ymax)-bound(all,ymin)
variable        leny equal ${tmp}
variable	    vtension equal sqrt(${srate}*${srate})*${leny}
variable	    nstep equal ${strainmax}*${leny}/${vtension}/${tstep}

#4 potentials

# --- Styles: AIREBO for graphene (C–C), Tersoff for MoSe2 (Mo–Se), LJ for interlayer vdW ---
pair_style  	hybrid   airebo 2.5   tersoff   lj/cut 10.0
#                               ^cut  ^LJ ^torsion      ^ LJ cutoff
# AIREBO only on carbon (type 13); all MoSe2 types = NULL
pair_coeff  	* *  airebo  CH.airebo   C NULL NULL
#                                                               (types 1..3)                               (13)

# MoSe2 intralayer bonding: Tersoff
# Map your 13 types: (1:C, 2:Se, 3:Mo)
pair_coeff  	* *  tersoff MoSe.tersoff       NULL Se Mo

# Interlayer vdW (12–6 LJ), ONLY between graphene C(13) and MoSe2 (Mo,Se); cutoff = 10.0 Å
# Values from Table 1 in the paper:
#   Mo–C:  ε = 0.003325 eV,  σ = 3.054 Å
#   Se–C:  ε = 0.007580 eV,  σ = 3.585 Å
# (Define one line per MoSe2 type ID.)
# ---- C(13) with Mo types:
pair_coeff  	 3   1  lj/cut    0.003325   3.054   10.0

# ---- C(13) with Se types:
pair_coeff  	 2   1  lj/cut    0.007580   3.585   10.0

#5 settings
#### Computes Required
compute csym all centro/atom 12
compute 2 all stress/atom NULL virial
compute mytemp all temp
compute peratom all pe/atom
compute eatoms all reduce sum c_peratom
compute 11 all reduce sum c_2[1]
compute 12 all reduce sum c_2[2]

#6 optimize at 0 K
timestep	    ${tstep}
#dump            1 all custom 1 dump.minimization id type x y z
#fix		     1 all box/relax x 0.0 y 0.0 vmax 0.001 				             #iso 0.0 vmax 0.001 
min_style	    cg
minimize 		1e-12 1e-12 50000 100000
#undump		    1
#unfix		    1

#7 optimize at T

#compute		    peratom all pe/atom
compute  STRESS  all   stress/atom   NULL
reset_timestep	0

velocity	    all create ${temperature} 87531 mom yes rot yes dist gaussian
#fix             mom all momentum 100 linear 0 1 1  

#---------------Energy Equilibriation--------------------------
fix             5 all nve
fix				2 all temp/rescale 10 ${temperature} ${temperature} 1.0 0.5
dump            1 all custom 1000 dump.optimize id type x y z c_peratom fx fy fz
thermo_style	custom step temp  lx ly lz pxx pyy pzz etotal
thermo		    1000
run		        100000
unfix           5
unfix			2

fix             8 all npt temp ${temperature} ${temperature} 10 x ${pressure} ${pressure} 10 y ${pressure} ${pressure} 10
run		        200000

variable        tmp equal ly
variable        ly0 equal ${tmp}

#8 tension by deform

undump		    1
reset_timestep	0
unfix		    8
fix             6 all nve
fix				7 all temp/rescale 10 ${temperature} ${temperature} 1.0 0.5
fix		        2 all deform 1 y erate ${srate} units box remap x

variable	    strain equal "(ly-v_ly0)/v_ly0"
variable	    p1 equal v_strain

# pressure unit, 1bar=10^5Pa=10^{-4}GPa
# for 2D materials, 1GPa=h*0.1N/m, with thickness h in the unit of angstrom

variable	    p2 equal "-(0.0001*pyy)*(lz*0.1)"
variable	    p3 equal "0.0001*pxx"
variable	    p4 equal "0.0001*pzz"
fix		        def1 all print 100 "${p1}   ${p2}   ${p3}   ${p4}" file strain.dat screen no

dump		    1 all custom 1000 dump.compression id type x y z c_peratom fx fy fz   c_STRESS[1]  c_STRESS[2]  c_STRESS[3]  c_STRESS[4]  c_STRESS[5]  c_STRESS[6]

#9 run md

thermo_style	custom step temp v_p1 v_p2 v_p3 v_p4 press etotal
thermo		    1000
thermo_modify 	lost warn
run		        ${nstep}

print		    "# Job done, Sir! See you."
